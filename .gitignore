# ── Client / engagement data — NEVER commit (confidential + live credentials) ──
engagements/
brain/targets/
brain/ruflo-export.jsonl
.t3mp3st/
**/.t3mp3st/

# ── Credentials / tokens / secrets ──
**/.token*
**/*.pem
**/*.key
**/.env
**/.env.*

# ── OS / scratch ──
.DS_Store
*.bak
.opt-hashes.tmp
/tmp/

# CDC harness per-target working state
.cdc/

# Externally-cloned packs (provenance + re-hydrate recipe in packs/UPSTREAM.md,
# scripts/reinstall-packs.sh). Nested .git dirs — never commit into this repo.
# EXCEPTIONS: EXTRACTION.md + integration markers are the pack's SPOT for
# integration state (verify-packs.sh contract) — those MUST survive a fresh
# clone even though the pack contents don't.
packs/xalgorix/**
!packs/xalgorix/EXTRACTION.md
!packs/xalgorix/.vendored
!packs/xalgorix/.internal
!packs/xalgorix/.deprecated
packs/dalfox/**
!packs/dalfox/EXTRACTION.md
!packs/dalfox/.vendored
!packs/dalfox/.internal
!packs/dalfox/.deprecated
