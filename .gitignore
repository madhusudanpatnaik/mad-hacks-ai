!packs/secrets-patterns-db/EXTRACTION.md
!packs/secrets-patterns-db/.vendored
!packs/secrets-patterns-db/.internal
!packs/secrets-patterns-db/.deprecated
packs/exploitarium/**
!packs/exploitarium/EXTRACTION.md
!packs/exploitarium/.vendored
!packs/exploitarium/.internal
!packs/exploitarium/.deprecated
