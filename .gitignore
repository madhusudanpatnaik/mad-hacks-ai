# Asset registry — assets.jsonl + assets.db are REGENERABLE from source via
# scripts/build-registry.py, so they're ignored. pack-index.jsonl is the SPOT
# for per-pack integration state (manually maintained by verify-packs.sh
# and the mining workflow) — that one MUST be tracked.
brain/registry/*
!brain/registry/pack-index.jsonl

# Retrieval telemetry — session-local aggregation data for pack-eval.sh.
# Not source of truth; per-machine noise.
brain/telemetry/

# Engagement state — per-target working memory, never commit
.engagement/

# Python compilation artifacts
__pycache__/
*.pyc

# Per-engagement audit state (never commit)
.audit/
